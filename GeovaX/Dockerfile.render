# Render deployment image for GEOVAX.
#
# Serves the FastAPI OGC API + harmonisation console (/map) straight from the
# committed, precomputed pipeline output in deploy_data/ — no PostGIS, no
# Redis, no worker. See backend/GeovaX/api/app.py: FeatureStore is a
# file-backed reader designed exactly for this ("runnable straight after a
# pipeline run with no database").
#
# Build context for this file is the repo's GeovaX/ subfolder (the one
# containing backend/, frontend/, deploy_data/ as siblings) — set that as the
# Render service's Root Directory. Single COPY . . on purpose: Render's
# builder kept reusing a stale cache ref for a separate `COPY deploy_data`
# step across rebuilds ("checksum of ref ...: not found"); copying the whole
# (dockerignore-trimmed) context in one instruction sidesteps that.

FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
      gdal-bin libgdal-dev libgeos-dev libproj-dev proj-data git curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY . .

# Diagnostic: prove what actually landed in the image before pip touches it.
RUN echo "--- /app ---" && ls -la /app \
    && echo "--- /app/backend ---" && ls -la /app/backend \
    && echo "--- pyproject.toml ---" && cat /app/backend/pyproject.toml | head -5

RUN pip install --no-cache-dir -e /app/backend

ENV PYTHONUNBUFFERED=1 \
    GEOVAX_OUT=/app/deploy_data/chennai_metro

EXPOSE 8000
CMD ["sh", "-c", "uvicorn GeovaX.api.app:app --host 0.0.0.0 --port ${PORT:-8000}"]
